{
  "runner": "claude-cli",
  "model": "opus",
  "maxDirectorRounds": 2,
  "voice": {
    "engine": "kokoro",
    "voice": "af_heart",
    "speed": 1.0,
    "paceSpeed": { "slow": 0.9, "normal": 1.0, "fast": 1.1 },
    "language": "auto",
    "padBeforeSec": 0.3,
    "padAfterSec": 0.3,
    "sampleRate": 24000,
    "pronunciationsFile": "pronunciations.json",
    "timing": "kokoro",
    "python": "",
    "auditionVoices": ["af_heart", "af_bella", "af_nicole", "am_michael", "am_fenrir", "bf_emma", "bm_george"],
    "auditionText": "Your phone knows where you are to within a few meters. Here is how GPS pulls it off."
  },
  "render": {
    "fps": 30,
    "resolution": 1080,
    "previewScale": 0.5,
    "stillScale": 0.5,
    "codec": "h264",
    "crf": 18,
    "previewCrf": 30,
    "concurrency": null,
    "browserExecutable": "",
    "transitionSec": 0.4,
    "outputDir": "final",
    "captions": {
      "enabled": true,
      "fontSize": 54,
      "position": "bottom",
      "highlight": "accent",
      "combineWithinMs": 1200
    },
    "music": {
      "file": "",
      "volume": 0.12
    }
  },
  "animator": {
    "maxFixRounds": 3,
    "stillsPerScene": 3,
    "parallelScenes": 1
  }
}
